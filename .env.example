# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of this app (http://localhost:3000 locally, your Render URL when deployed)
APP_URL=http://localhost:3000

# sandbox (default) or live
PAYPAL_ENV=sandbox

# Claude API key (console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# Demo shop 1: "Asha's Handmade" — a sandbox REST app linked to sandbox BUSINESS account #1
# Enable "Transaction search" (and card payments for seeding) in the app's features.
ASHA_CLIENT_ID=
ASHA_CLIENT_SECRET=
# Optional: webhook ID from the app's Webhooks section, enables signature verification
ASHA_WEBHOOK_ID=

# Demo shop 2: "New Leaf Store" — a sandbox REST app linked to sandbox BUSINESS account #2
NEWLEAF_CLIENT_ID=
NEWLEAF_CLIENT_SECRET=
NEWLEAF_WEBHOOK_ID=

# Where the local SQLite cache lives (optional)
# DATA_DIR=.data
